# Copy to functions/.env (or .env.<projectId>) to configure Cloud Functions.
# Real SMS is sent ONLY when SMS_SENDING_ENABLED is exactly "true" AND
# SMS_PROVIDER is "twilio" or "http". Anything else => MockSmsProvider.
SMS_PROVIDER=
SMS_SENDING_ENABLED=false
# Sender id / from-number registered with the provider.
SMS_SENDER_ID=
# Only for SMS_PROVIDER=http (generic JSON gateway).
SMS_HTTP_URL=
# Set to "true" to log pushes instead of sending them.
PUSH_DISABLED=false
