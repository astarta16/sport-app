rules_version = '2';

// Sport Parent App — Firestore security rules.
// Default: deny everything. Every collection below is opened explicitly.
//
// Roles live in users/{uid}.role ("parent" | "child" | "coach" | "admin").
// Admin rights are granted ONLY by the custom claim `admin == true`
// (set server-side); the `admin` role value is never client-assignable.
// Fields marked "server-managed" are written by Cloud Functions (Admin SDK,
// which bypasses these rules) and are read-only for clients.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Platform admin = custom claim admin == true (alias of isAdmin()).
    function isPlatformAdmin() {
      return isAdmin();
    }

    // Club admin = custom claim clubAdmin: [clubId, …] (set only by setAdminRole).
    function clubAdminIds() {
      return request.auth.token.get('clubAdmin', []);
    }

    function isClubAdmin(clubId) {
      return signedIn() && clubId is string && clubAdminIds() is list && clubId in clubAdminIds();
    }

    function isAdminOfClub(clubId) {
      return isPlatformAdmin() || isClubAdmin(clubId);
    }

    function trainingDoc(trainingId) {
      return get(/databases/$(database)/documents/trainings/$(trainingId)).data;
    }

    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }

    function optTimestamp(d, key) {
      return !(key in d) || d[key] == null || d[key] is timestamp;
    }

    // Cancelling (status -> cancelled) requires a reason code, a 5–300 char
    // reason and cancelledBy == caller. Applies to trainings and matches.
    function validCancelTransition(before, after) {
      return after.status != 'cancelled'
        || (before != null && before.status == 'cancelled')
        || (after.get('cancelReasonCode', null) in ['illness', 'weather', 'venueBusy', 'other']
            && after.get('cancelReason', null) is string
            && after.cancelReason.trim().size() >= 5
            && after.cancelReason.size() <= 300
            && after.get('cancelledBy', null) == uid());
    }

    function validCancelFields(d) {
      return (!('cancelReasonCode' in d) || d.cancelReasonCode == null
              || d.cancelReasonCode in ['illness', 'weather', 'venueBusy', 'other'])
        && optString(d, 'cancelReason', 300)
        && optTimestamp(d, 'cancelledAt')
        && optString(d, 'cancelledBy', 128);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(uid()));
    }

    function me() {
      return get(userPath(uid())).data;
    }

    function isParent() {
      return hasProfile() && me().role == 'parent';
    }

    function isChildAccount() {
      return hasProfile() && me().role == 'child';
    }

    function isApprovedCoach() {
      return hasProfile()
        && me().role == 'coach'
        && me().get('coachStatus', '') == 'approved';
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function childDoc(childId) {
      return get(/databases/$(database)/documents/children/$(childId)).data;
    }

    // Parent who currently has a child in the group (group.parentIds is
    // maintained by the onGroupWritten Cloud Function).
    function isGroupParent(groupId) {
      return isParent() && uid() in groupDoc(groupId).get('parentIds', []);
    }

    // Approved coach currently assigned to the group.
    function isGroupCoach(groupId) {
      return isApprovedCoach() && uid() in groupDoc(groupId).get('coachIds', []);
    }

    function isParentOfChild(childId) {
      return isParent() && uid() in childDoc(childId).get('parentIds', []);
    }

    // Approved coach of any group that currently contains the child.
    // children.coachIds is server-managed (recomputed from groups on every
    // membership/coach change), so revoking membership revokes access.
    function isCoachOfChild(childId) {
      return isApprovedCoach() && uid() in childDoc(childId).get('coachIds', []);
    }

    // v1.3: coaches explicitly authorized to verify payments of the group
    // (groups.paymentManagerIds, set only through the updateGroup callable).
    function isPaymentManager(groupId) {
      return isApprovedCoach() && uid() in groupDoc(groupId).get('paymentManagerIds', []);
    }

    // Payment reviewer: payment manager of the group or club admin of its club.
    function isPaymentReviewer(groupId) {
      return isPaymentManager(groupId) || isClubAdmin(groupDoc(groupId).get('clubId', ''));
    }

    function planDoc(planId) {
      return get(/databases/$(database)/documents/trainingPlans/$(planId)).data;
    }

    // A child account is linked through children/{childId}.userId == uid.
    // The child id is taken from users/{uid}.lastContext.childId and then
    // verified against the child doc, so a forged lastContext grants nothing.
    function myChildId() {
      return me().get('lastContext', {}).get('childId', '');
    }

    function isChildAccountInGroup(groupId) {
      return isChildAccount()
        && myChildId() != ''
        && childDoc(myChildId()).get('userId', '') == uid()
        && groupId in childDoc(myChildId()).get('groupIds', []);
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isStringList(v) {
      return v is list;
    }

    // ------------------------------------------------------- public catalogue
    // Guest mode: readable without authentication. Writes: admin only.
    match /sports/{sportId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // Club admins may edit their club's details, never adminIds/status
    // (archiveClub / setAdminRole are platform-only callables).
    match /clubs/{clubId} {
      allow read: if true;
      allow create, delete: if isPlatformAdmin();
      allow update: if isPlatformAdmin()
        || (isClubAdmin(clubId) && !changed(['adminIds', 'status', 'createdAt']));

      // Server-maintained public projection of the club's groups (no ids of
      // members, parents or coaches) for the guest map and join flow.
      match /publicGroups/{groupId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Approved coaches may add UNVERIFIED venues; only a platform admin verifies.
    match /venues/{venueId} {
      allow read: if true;
      allow create: if isPlatformAdmin()
        || (isApprovedCoach()
            && request.resource.data.keys().hasOnly([
                 'clubId', 'name', 'address', 'location', 'geohash', 'sportIds', 'type',
                 'verified', 'createdBy', 'createdAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
            && request.resource.data.verified == false
            && request.resource.data.createdBy == uid());
      allow update, delete: if isPlatformAdmin();
    }

    // Coach ↔ club assignments (assignCoach callable). Server only.
    match /coachClubs/{id} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.coachId == uid())
        || isClubAdmin(resource.data.clubId);
      allow write: if false;
    }

    // ------------------------------------------------------------------ users
    // Contains phone numbers => readable only by the owner (and admins).
    // Other users see publicProfiles/{uid} instead.
    match /users/{userId} {
      function validNotificationPrefs(d) {
        return !('notificationPrefs' in d)
          || (d.notificationPrefs is map
              && d.notificationPrefs.keys().hasOnly([
                   'newTraining', 'trainingChanged', 'trainingReminder',
                   'chatMessage', 'certificateExpiry', 'newPhotos',
                   'paymentReminder', 'paymentSms',
                   'newMatch', 'matchChanged', 'matchReminder', 'groupInvite',
                   'inviteAnswered', 'attendanceRecorded', 'feedbackAdded',
                   'announcement', 'newMedia', 'scheduleChanged',
                   // v1.3
                   'paymentProofSubmitted', 'paymentProofApproved', 'paymentProofRejected',
                   'trainingPlanPublished']));
      }

      function validUserShape(d) {
        return d.keys().hasOnly([
                 'role', 'firstName', 'lastName', 'phone', 'createdAt',
                 'lastContext', 'fcmTokens', 'coachStatus', 'clubIds',
                 'sportIds', 'smsConsentAt', 'dataConsentAt',
                 'notificationPrefs', 'photoPath', 'privacy', 'locale',
                 // server-managed (never client-set, see create/update):
                 'coachStatusReason', 'adminRole', 'adminClubIds'])
          && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 100
          && d.lastName is string && d.lastName.size() <= 100
          && (!('phone' in d) || d.phone is string)
          && (!('fcmTokens' in d) || isStringList(d.fcmTokens))
          && (!('clubIds' in d) || isStringList(d.clubIds))
          && (!('sportIds' in d) || isStringList(d.sportIds))
          && (!('lastContext' in d) || d.lastContext is map)
          && (!('smsConsentAt' in d) || d.smsConsentAt == null || d.smsConsentAt is timestamp)
          && (!('photoPath' in d) || d.photoPath == null
              || d.photoPath == 'profiles/' + userId + '/avatar.jpg')
          && (!('privacy' in d) || (d.privacy is map
              && d.privacy.keys().hasOnly(['profilePhotoVisible', 'analyticsConsent'])))
          && (!('locale' in d) || d.locale in ['ka', 'en', 'ru'])
          && validNotificationPrefs(d);
      }

      // Club admins read coach profiles of coaches assigned to their clubs.
      allow read: if (signedIn() && uid() == userId) || isAdmin()
        || (signedIn()
            && resource.data.get('role', '') == 'coach'
            && clubAdminIds() is list
            && resource.data.get('clubIds', []).hasAny(clubAdminIds()));

      // Self-registration: only parent or coach; coaches always start pending.
      allow create: if signedIn()
        && uid() == userId
        && validUserShape(request.resource.data)
        && request.resource.data.dataConsentAt is timestamp
        && !request.resource.data.keys().hasAny(['coachStatusReason', 'adminRole', 'adminClubIds'])
        && (
          (request.resource.data.role == 'parent'
            && !('coachStatus' in request.resource.data))
          || (request.resource.data.role == 'coach'
            && request.resource.data.coachStatus == 'pending')
        );

      // Owner may edit their profile but never role / coachStatus.
      // An approved coach can no longer change clubIds (admin decides).
      allow update: if signedIn()
        && uid() == userId
        && validUserShape(request.resource.data)
        && !changed(['role', 'coachStatus', 'createdAt', 'dataConsentAt',
                     'coachStatusReason', 'adminRole', 'adminClubIds'])
        && !(resource.data.get('coachStatus', '') == 'approved' && changed(['clubIds']));

      // Account deletion goes through the deleteAccount callable.
      allow delete: if false;
    }

    // Server-managed mirror of users/{uid} without the phone number.
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --------------------------------------------------------------- children
    match /children/{childId} {
      function validChild(d) {
        return d.keys().hasOnly([
                 'firstName', 'lastName', 'birthDate', 'parentIds', 'userId',
                 'sportIds', 'groupIds', 'photoConsent', 'coachIds',
                 'status', 'createdByCoachId', 'photoPath', 'mediaConsent', 'mediaConsentAt'])
          && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 100
          && d.lastName is string && d.lastName.size() <= 100
          && d.birthDate is timestamp
          && d.parentIds is list
          && (!('sportIds' in d) || d.sportIds is list)
          && (!('photoConsent' in d) || d.photoConsent is bool)
          && (!('mediaConsent' in d) || d.mediaConsent is bool)
          && optTimestamp(d, 'mediaConsentAt')
          && (!('status' in d) || d.status in ['active', 'pendingParent'])
          && (!('photoPath' in d) || d.photoPath == null
              || d.photoPath == 'childPhotos/' + childId + '/avatar.jpg');
      }

      // Club admins have NO direct child access (only aggregate counts via
      // adminStats). A coach sees a coach-created pending child (first/last
      // name + birth date only) until a parent accepts the invite.
      allow read: if isAdmin()
        || (isParent() && uid() in resource.data.parentIds)
        || (isChildAccount() && resource.data.get('userId', '') == uid())
        || (isApprovedCoach() && uid() in resource.data.get('coachIds', []))
        || (isApprovedCoach()
            && resource.data.get('status', 'active') == 'pendingParent'
            && resource.data.get('createdByCoachId', '') == uid());

      // The creating parent must list themself; group membership, coach
      // access and account links are server-managed.
      allow create: if isParent()
        && validChild(request.resource.data)
        && uid() in request.resource.data.parentIds
        && request.resource.data.parentIds.size() <= 4
        && request.resource.data.get('groupIds', []).size() == 0
        && request.resource.data.get('coachIds', []).size() == 0
        && request.resource.data.get('userId', null) == null
        && request.resource.data.get('status', 'active') == 'active'
        && request.resource.data.get('createdByCoachId', null) == null;

      allow update: if isParent()
        && uid() in resource.data.parentIds
        && validChild(request.resource.data)
        && !changed(['parentIds', 'groupIds', 'coachIds', 'userId', 'status', 'createdByCoachId']);

      allow delete: if isParent() && uid() in resource.data.parentIds;
    }

    // ----------------------------------------------------------------- groups
    match /groups/{groupId} {
      allow read: if isAdmin()
        || (isParent() && uid() in resource.data.get('parentIds', []))
        || (isApprovedCoach() && uid() in resource.data.get('coachIds', []))
        || isClubAdmin(resource.data.get('clubId', ''));

      // An approved coach assigned to an active club may create a group in it
      // (or use the createGroup callable). They must be its only coach; the
      // invite code is assigned by the server (inviteCode absent or '').
      // paymentManagerIds is server-managed (updateGroup callable, audited) —
      // not even a platform admin writes it directly.
      allow create: if isAdmin() && request.resource.data.get('inviteCode', '') == ''
          && !('paymentManagerIds' in request.resource.data)
        || (isApprovedCoach()
            && request.resource.data.keys().hasOnly([
                 'clubId', 'sportId', 'coachIds', 'name', 'ageMin', 'ageMax',
                 'memberChildIds', 'parentIds', 'scheduleNote', 'inviteCode',
                 'createdBy', 'status', 'createdAt'])
            && request.resource.data.clubId is string
            && request.resource.data.clubId in me().get('clubIds', [])
            && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
                 .data.get('status', 'active') == 'active'
            && request.resource.data.coachIds == [uid()]
            && request.resource.data.createdBy == uid()
            && request.resource.data.status == 'active'
            && request.resource.data.get('inviteCode', '') == ''
            && request.resource.data.get('memberChildIds', []).size() == 0
            && request.resource.data.get('parentIds', []).size() == 0
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100);

      allow delete: if isAdmin();

      // Admin: anything but the server-owned inviteCode. Coach of the group:
      // may only REMOVE members. Adding members happens server-side (approved
      // membership request / accepted invite). parentIds is recomputed by
      // the onGroupWritten trigger.
      allow update: if (isAdmin() && !changed(['inviteCode', 'paymentManagerIds', 'mediaDownloadsEnabled']))
        || (isApprovedCoach()
            && uid() in resource.data.get('coachIds', [])
            && changedOnly(['memberChildIds'])
            && request.resource.data.memberChildIds is list
            && request.resource.data.memberChildIds.toSet()
                 .difference(resource.data.get('memberChildIds', []).toSet())
                 .size() == 0);
    }

    // -------------------------------------------------------------- trainings
    match /trainings/{trainingId} {
      function validTraining(d) {
        return d.keys().hasOnly([
                 'groupId', 'venueId', 'startAt', 'durationMin', 'focus',
                 'description', 'photoUrls', 'status', 'createdBy',
                 'updatedAt', 'previousStartAt', 'reminderSentAt',
                 'cancelReasonCode', 'cancelReason', 'cancelledAt', 'cancelledBy',
                 'seriesId', 'occurrenceDate', 'detached'])
          && d.groupId is string
          && d.venueId is string
          && d.startAt is timestamp
          && d.durationMin is int
          && d.durationMin >= 15 && d.durationMin <= 300
          && d.focus is list
          && d.focus.hasOnly(['technique', 'speed', 'physical', 'ball'])
          && (!('description' in d) || (d.description is string && d.description.size() <= 2000))
          && (!('photoUrls' in d) || d.photoUrls is list)
          && d.status in ['scheduled', 'cancelled', 'moved', 'done']
          && validCancelFields(d)
          && optString(d, 'seriesId', 200)
          && optString(d, 'occurrenceDate', 10)
          && (!('detached' in d) || d.detached is bool);
      }

      allow read: if isAdmin()
        || isGroupParent(resource.data.groupId)
        || isGroupCoach(resource.data.groupId)
        || isChildAccountInGroup(resource.data.groupId)
        || isClubAdmin(groupDoc(resource.data.groupId).get('clubId', ''));

      // Clients create one-off trainings only; series occurrences are
      // generated by the server (onSeriesWritten / extendTrainingSeries).
      allow create: if isGroupCoach(request.resource.data.groupId)
        && validTraining(request.resource.data)
        && request.resource.data.createdBy == uid()
        && request.resource.data.status == 'scheduled'
        && !('reminderSentAt' in request.resource.data)
        && request.resource.data.get('seriesId', null) == null;

      // Any approved coach of the (unchanged) group may edit; createdBy,
      // groupId, series linkage and the reminder bookkeeping are immutable
      // from clients. Cancelling requires a reason (validCancelTransition).
      allow update: if isGroupCoach(resource.data.groupId)
        && validTraining(request.resource.data)
        && !changed(['groupId', 'createdBy', 'reminderSentAt', 'seriesId', 'occurrenceDate'])
        && validCancelTransition(resource.data, request.resource.data);

      // Trainings are cancelled (status), not deleted.
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------- chat
    // Child accounts can never read or write chats: membership requires the
    // parent role (via group.parentIds) or an approved coach.
    match /chats/{groupId} {
      allow read, write: if false;

      match /messages/{messageId} {
        function isChatMember() {
          return isGroupParent(groupId) || isGroupCoach(groupId);
        }

        allow read: if isChatMember();

        // type 'system' is server-only; announcements and pinning are for
        // approved group coaches; hidden/reportCount are server-managed.
        // Hidden messages stay readable by members — the app filters them.
        allow create: if isChatMember()
          && request.resource.data.keys().hasOnly([
               'senderId', 'senderName', 'senderRole', 'text',
               'attachments', 'createdAt', 'type', 'pinned', 'hidden', 'requiresAck'])
          // v1.4: only an approved group coach may ask for acknowledgment.
          && (request.resource.data.get('requiresAck', false) == false
              || (request.resource.data.requiresAck == true && isGroupCoach(groupId)))
          && request.resource.data.get('type', 'text') in ['text', 'announcement']
          && request.resource.data.get('hidden', false) == false
          && (request.resource.data.get('pinned', false) == false || isGroupCoach(groupId))
          && (request.resource.data.get('type', 'text') == 'text' || isGroupCoach(groupId))
          && request.resource.data.senderId == uid()
          && request.resource.data.senderRole == me().role
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 200
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!('attachments' in request.resource.data)
              || (request.resource.data.attachments is list
                  && request.resource.data.attachments.size() <= 10))
          && request.resource.data.createdAt == request.time;

        // Messages are immutable except that an approved group coach may
        // (un)pin. The sender may delete their own.
        allow update: if isGroupCoach(groupId)
          && changedOnly(['pinned'])
          && request.resource.data.pinned is bool;
        allow delete: if signedIn() && resource.data.senderId == uid();

        // v1.4 read receipts / acknowledgments. One immutable doc per parent
        // (id = uid), written only by that parent while still a group parent,
        // only if they are in the recipient snapshot taken by the server when
        // the message was created. The time is the server's (request.time),
        // never a client clock. Only the sending coach (still an approved
        // coach of the group) and the parent themselves can read them.
        function receipt() {
          return get(/databases/$(database)/documents/chats/$(groupId)/receipts/$(messageId)).data;
        }
        function validMark(d, readerId, field) {
          return readerId == uid()
            && d.keys().hasOnly(['uid', 'groupId', 'messageId', field])
            && d.uid == uid() && d.groupId == groupId && d.messageId == messageId
            && d[field] == request.time;
        }
        function canMark(readerId) {
          return isGroupParent(groupId)
            && exists(/databases/$(database)/documents/chats/$(groupId)/receipts/$(messageId))
            && readerId in receipt().recipientIds;
        }
        function isSenderCoach() {
          return isGroupCoach(groupId) && receipt().senderId == uid();
        }

        match /msgReads/{readerId} {
          allow read: if signedIn() && (resource.data.uid == uid() || isSenderCoach());
          allow create: if validMark(request.resource.data, readerId, 'readAt') && canMark(readerId);
          allow update, delete: if false;
        }

        match /msgAcks/{readerId} {
          allow read: if signedIn() && (resource.data.uid == uid() || isSenderCoach());
          allow create: if validMark(request.resource.data, readerId, 'ackAt') && canMark(readerId)
            && receipt().requiresAck == true;
          allow update, delete: if false;
        }
      }

      // Recipient snapshot + counters, server-written (onChatMessageCreated);
      // readable only by the sending coach while still coach of the group.
      match /receipts/{messageId} {
        allow read: if isGroupCoach(groupId) && resource.data.senderId == uid();
        allow write: if false;
      }

      // Read receipts: each chat member writes only their own lastReadAt.
      match /members/{memberId} {
        function isMember() {
          return isGroupParent(groupId) || isGroupCoach(groupId);
        }
        allow read: if signedIn() && memberId == uid() && isMember();
        allow create, update: if signedIn() && memberId == uid() && isMember()
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt is timestamp;
        allow delete: if false;
      }
    }

    // v1.4: a parent lists their OWN read / acknowledgment marks (collection
    // group query by uid + groupId) so the app never re-writes them.
    match /{path=**}/msgReads/{readerId} {
      allow read: if signedIn() && resource.data.uid == uid();
    }
    match /{path=**}/msgAcks/{readerId} {
      allow read: if signedIn() && resource.data.uid == uid();
    }

    // v1.4 media download events (getMediaDownload): server-written; the
    // platform admin and the club's admins read them for audit.
    match /mediaDownloads/{id} {
      allow read: if isPlatformAdmin() || isClubAdmin(resource.data.get('clubId', ''));
      allow write: if false;
    }

    // Unread counters maintained by onChatMessageCreated / onChatMemberWritten.
    match /userUnread/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow write: if false;
    }

    // ---------------------------------------------------- medical certificates
    // Only metadata lives here. The file itself is never client-readable;
    // use the getCertificateUrl callable (short-lived signed URL + audit log).
    match /medicalCertificates/{certId} {
      allow read: if isAdmin()
        || isParentOfChild(resource.data.childId)
        || isCoachOfChild(resource.data.childId);

      allow create: if isParentOfChild(request.resource.data.childId)
        && request.resource.data.keys().hasOnly([
             'childId', 'uploadedBy', 'storagePath', 'issuedAt',
             'validUntil', 'consentAt', 'status', 'groupId', 'sportId'])
        // v1.3: optional scope (null = general certificate)
        && optString(request.resource.data, 'groupId', 128)
        && optString(request.resource.data, 'sportId', 128)
        && request.resource.data.uploadedBy == uid()
        && request.resource.data.storagePath
             == 'medical/' + request.resource.data.childId + '/' + certId
        && request.resource.data.issuedAt is timestamp
        && request.resource.data.validUntil is timestamp
        && request.resource.data.validUntil > request.resource.data.issuedAt
        && request.resource.data.consentAt is timestamp
        && request.resource.data.status in ['valid', 'expiring', 'expired'];

      // Status and notification bookkeeping are server-managed. v1.3: a parent
      // of the child may mark an OLDER certificate as replaced by another
      // certificate of the same child — only replacedBy + replacedAt.
      allow update: if isParentOfChild(resource.data.childId)
        && changedOnly(['replacedBy', 'replacedAt'])
        && request.resource.data.replacedBy is string
        && request.resource.data.replacedBy != certId
        && exists(/databases/$(database)/documents/medicalCertificates/$(request.resource.data.replacedBy))
        && get(/databases/$(database)/documents/medicalCertificates/$(request.resource.data.replacedBy))
             .data.childId == resource.data.childId
        && request.resource.data.replacedAt is timestamp;

      // Deleting the doc triggers deletion of the storage file
      // (onCertificateDeleted). The deleteCertificate callable does both.
      allow delete: if isParentOfChild(resource.data.childId);
    }

    match /certificateAccessLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------- membership requests
    match /membershipRequests/{requestId} {
      function isClubCoach(clubId) {
        return isApprovedCoach() && clubId in me().get('clubIds', []);
      }

      allow read: if isAdmin()
        || (isParent() && resource.data.parentId == uid())
        || isClubCoach(resource.data.clubId)
        || isClubAdmin(resource.data.clubId);

      allow create: if isParent()
        && request.resource.data.keys().hasOnly([
             'parentId', 'childId', 'clubId', 'groupId', 'status', 'createdAt', 'childName', 'source'])
        && request.resource.data.get('source', 'request') in ['request', 'code']
        // childName: denormalized first name so the coach can review the
        // request without reading a non-member child's profile.
        && (!('childName' in request.resource.data)
            || (request.resource.data.childName is string
                && request.resource.data.childName.size() <= 40))
        && request.resource.data.parentId == uid()
        && isParentOfChild(request.resource.data.childId)
        && request.resource.data.clubId is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // A coach of the club decides. Approval must name a group the coach
      // runs; the onMembershipRequestUpdated trigger then adds the child.
      allow update: if isClubCoach(resource.data.clubId)
        && resource.data.status == 'pending'
        && changedOnly(['status', 'groupId'])
        && (
          request.resource.data.status == 'rejected'
          || (request.resource.data.status == 'approved'
              && request.resource.data.groupId is string
              && isGroupCoach(request.resource.data.groupId)
              && groupDoc(request.resource.data.groupId).clubId == resource.data.clubId)
        );

      // The requesting parent may withdraw a pending request.
      allow delete: if isParent()
        && resource.data.parentId == uid()
        && resource.data.status == 'pending';
    }

    // --------------------------------------------------------------- payments
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isParent() && resource.data.parentId == uid())
        || isGroupCoach(resource.data.groupId)
        || isPaymentReviewer(resource.data.groupId);

      // Payments are generated server-side (generateRecurringPayments) or by admins.
      allow create, delete: if isAdmin();

      // Parents never write payments. v1.3: only a payment reviewer — an
      // approved coach in group.paymentManagerIds or a club admin of the
      // group's club — may change status/paidAt/cancelledReason (+
      // updatedBy/updatedAt bookkeeping); a coach who is not a payment
      // manager can no longer change payment status. If updatedBy is present
      // it must be the caller (paymentAudit actor). verification / verifiedBy
      // / verifiedAt are server-only (reviewPaymentProof), even for admins.
      allow update: if (isAdmin() && !changed(['verification', 'verifiedBy', 'verifiedAt']))
        || (isPaymentReviewer(resource.data.groupId)
            && changedOnly(['status', 'paidAt', 'cancelledReason', 'updatedBy', 'updatedAt'])
            && request.resource.data.status in ['pending', 'paid', 'cancelled']
            && (!('paidAt' in request.resource.data)
                || request.resource.data.paidAt == null
                || request.resource.data.paidAt is timestamp)
            && optString(request.resource.data, 'cancelledReason', 300)
            && optTimestamp(request.resource.data, 'updatedAt')
            && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == uid()));
    }

    // v1.3: payment proofs (receipts). All writes through callables
    // (submitPaymentProof / startPaymentReview / reviewPaymentProof).
    // Reviewer list queries must constrain groupId (payment managers) or
    // clubId (club admins) so the rule is provable.
    match /paymentProofs/{proofId} {
      allow read: if isAdmin()
        || (isParent() && resource.data.parentId == uid())
        || isPaymentManager(resource.data.groupId)
        || isClubAdmin(resource.data.get('clubId', ''))
        || isClubAdmin(groupDoc(resource.data.groupId).get('clubId', ''));
      allow write: if false;
    }

    // Server-written verification history. Readable by the payment's parent,
    // payment reviewers of its group and club admins (resolved through the
    // payment, so `where paymentId == X` queries work).
    match /paymentVerificationEvents/{eventId} {
      function paymentOf(paymentId) {
        return get(/databases/$(database)/documents/payments/$(paymentId)).data;
      }
      allow read: if isAdmin()
        || (signedIn() && paymentOf(resource.data.paymentId).parentId == uid())
        || isPaymentReviewer(paymentOf(resource.data.paymentId).groupId);
      allow write: if false;
    }

    // Server-written (onPaymentWritten) status history.
    match /paymentAudit/{entryId} {
      allow read: if isAdmin()
        || isClubAdmin(resource.data.get('clubId', ''))
        || isGroupCoach(resource.data.groupId);
      allow write: if false;
    }

    match /paymentPlans/{planId} {
      function validPlan(d) {
        return d.keys().hasOnly([
                 'groupId', 'sportId', 'amount', 'currency', 'dayOfMonth',
                 'active', 'createdBy'])
          && d.groupId is string
          && d.sportId is string
          && d.amount is number && d.amount > 0
          && d.currency == 'GEL'
          && d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 28
          && d.active is bool;
      }

      allow read: if isAdmin() || isGroupCoach(resource.data.groupId);

      allow create: if isAdmin()
        || (isGroupCoach(request.resource.data.groupId)
            && validPlan(request.resource.data)
            && request.resource.data.createdBy == uid());

      allow update: if isAdmin()
        || (isGroupCoach(resource.data.groupId)
            && validPlan(request.resource.data)
            && changedOnly(['amount', 'dayOfMonth', 'active']));

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- invites
    // Created/answered only through callables (createInvite, respondInvite,
    // revokeInvite). The addressed parent and the group's coaches read.
    match /invites/{inviteId} {
      allow read: if isAdmin()
        || (isParent() && resource.data.get('parentId', '') == uid())
        || isGroupCoach(resource.data.groupId);
      allow write: if false;
    }

    match /groupCodes/{code} {
      allow read, write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- matches
    match /matches/{matchId} {
      function validMatch(d) {
        return d.keys().hasOnly([
                 'groupId', 'clubId', 'venueId', 'startAt', 'durationMin', 'opponentName',
                 'matchType', 'homeAway', 'description', 'status', 'cancelReasonCode',
                 'cancelReason', 'cancelledAt', 'cancelledBy', 'previousStartAt',
                 'createdBy', 'updatedAt', 'reminder1dSentAt', 'reminder2hSentAt', 'result'])
          && d.groupId is string
          && d.clubId is string
          && d.venueId is string
          && d.startAt is timestamp
          && d.durationMin is int && d.durationMin >= 15 && d.durationMin <= 300
          && d.opponentName is string && d.opponentName.size() > 0 && d.opponentName.size() <= 200
          && d.matchType in ['friendly', 'league', 'tournament']
          && d.homeAway in ['home', 'away', 'neutral']
          && optString(d, 'description', 2000)
          && d.status in ['scheduled', 'cancelled', 'moved', 'played']
          && optTimestamp(d, 'previousStartAt')
          && validCancelFields(d);
      }

      // Reminder flags are server-managed: a client may keep or drop them, never set them.
      function remindersUntouched() {
        return (request.resource.data.get('reminder1dSentAt', null) == null
                || request.resource.data.reminder1dSentAt == resource.data.get('reminder1dSentAt', null))
          && (request.resource.data.get('reminder2hSentAt', null) == null
                || request.resource.data.reminder2hSentAt == resource.data.get('reminder2hSentAt', null));
      }

      allow read: if isAdmin()
        || isGroupParent(resource.data.groupId)
        || isGroupCoach(resource.data.groupId)
        || isChildAccountInGroup(resource.data.groupId)
        || isClubAdmin(resource.data.get('clubId', ''));

      allow create: if isGroupCoach(request.resource.data.groupId)
        && validMatch(request.resource.data)
        && request.resource.data.clubId == groupDoc(request.resource.data.groupId).clubId
        && request.resource.data.createdBy == uid()
        && request.resource.data.status == 'scheduled'
        && !('reminder1dSentAt' in request.resource.data)
        && !('reminder2hSentAt' in request.resource.data)
        && !('result' in request.resource.data);

      // v1.5: `result` is written only by the recordMatchResult callable
      // (score validation, trusted time, audit, correction history).
      allow update: if isGroupCoach(resource.data.groupId)
        && validMatch(request.resource.data)
        && !changed(['groupId', 'clubId', 'createdBy', 'result'])
        && remindersUntouched()
        && validCancelTransition(resource.data, request.resource.data);

      allow delete: if isAdmin();

      // v1.5 result corrections (server-written, immutable).
      match /resultHistory/{version} {
        allow read: if isAdmin() || isGroupCoach(get(/databases/$(database)/documents/matches/$(matchId)).data.groupId);
        allow write: if false;
      }
    }

    // ------------------------------------------------- v1.5 child conversations
    // One thread per (child, coach): id = childId + '_' + coachId. Visible
    // only to the child's CURRENT guardians and to that coach while they
    // coach a group containing the child (children.coachIds is server-
    // maintained). Other parents never see it; children have no access.
    match /childThreads/{threadId} {
      function threadDoc() {
        return get(/databases/$(database)/documents/childThreads/$(threadId)).data;
      }
      function isThreadMember(childId, coachId) {
        return isParentOfChild(childId) || (uid() == coachId && isCoachOfChild(childId));
      }

      allow read: if signedIn() && isThreadMember(resource.data.childId, resource.data.coachId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['childId', 'coachId', 'createdBy', 'createdAt'])
        && request.resource.data.childId is string && request.resource.data.coachId is string
        && threadId == request.resource.data.childId + '_' + request.resource.data.coachId
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt == request.time
        // The coach must currently coach the child (a parent cannot pick any coach).
        && request.resource.data.coachId in childDoc(request.resource.data.childId).get('coachIds', [])
        && isThreadMember(request.resource.data.childId, request.resource.data.coachId);
      allow update, delete: if false; // lastMessageAt is server-maintained

      match /messages/{messageId} {
        allow read: if signedIn() && isThreadMember(threadDoc().childId, threadDoc().coachId);
        allow create: if signedIn()
          && isThreadMember(threadDoc().childId, threadDoc().coachId)
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == uid()
          && request.resource.data.senderRole == me().role
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 200
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------- training series
    match /trainingSeries/{seriesId} {
      function validSeries(d) {
        return d.keys().hasOnly([
                 'groupId', 'clubId', 'venueId', 'weekdays', 'startTime', 'durationMin',
                 'focus', 'description', 'startDate', 'endDate', 'status', 'createdBy',
                 'createdAt', 'updatedAt', 'generatedUntil', 'parentSeriesId'])
          && d.groupId is string
          && d.venueId is string
          && d.weekdays is list
          && d.weekdays.size() >= 1 && d.weekdays.size() <= 7
          && d.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
          && d.startTime is string && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && d.durationMin is int && d.durationMin >= 15 && d.durationMin <= 300
          && d.focus is list && d.focus.hasOnly(['technique', 'speed', 'physical', 'ball'])
          && (!('description' in d) || (d.description is string && d.description.size() <= 2000))
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (!('endDate' in d) || d.endDate == null
              || (d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && d.status in ['active', 'ended']
          && optString(d, 'parentSeriesId', 200)
          && optString(d, 'generatedUntil', 10);
      }

      allow read: if isAdmin()
        || isGroupCoach(resource.data.groupId)
        || isGroupParent(resource.data.groupId)
        || isClubAdmin(resource.data.get('clubId', ''));

      // A split-off series ("edit this and future") names its parent, which
      // must belong to the same group.
      allow create: if isGroupCoach(request.resource.data.groupId)
        && validSeries(request.resource.data)
        && request.resource.data.clubId == groupDoc(request.resource.data.groupId).clubId
        && request.resource.data.createdBy == uid()
        && request.resource.data.status == 'active'
        && (request.resource.data.get('parentSeriesId', null) == null
            || get(/databases/$(database)/documents/trainingSeries/$(request.resource.data.parentSeriesId))
                 .data.groupId == request.resource.data.groupId);

      allow update: if isGroupCoach(resource.data.groupId)
        && validSeries(request.resource.data)
        && !changed(['groupId', 'clubId', 'createdBy', 'parentSeriesId']);

      // Series are ended (status 'ended' / endDate), not deleted.
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------- RSVPs
    // Parent intent; id = {trainingId}_{childId}. Writable by a parent of a
    // child who is a member of the training's group, until the training starts.
    match /rsvps/{rsvpId} {
      function validRsvp(d) {
        return d.keys().hasOnly(['trainingId', 'groupId', 'childId', 'parentId', 'response', 'reason', 'updatedAt'])
          && d.trainingId is string && d.childId is string && d.groupId is string
          && rsvpId == d.trainingId + '_' + d.childId
          && d.parentId == uid()
          && d.response in ['yes', 'no', 'maybe']
          && optString(d, 'reason', 200)
          && d.updatedAt is timestamp;
      }

      function canRsvp(d) {
        return isParentOfChild(d.childId)
          && exists(/databases/$(database)/documents/trainings/$(d.trainingId))
          && trainingDoc(d.trainingId).groupId == d.groupId
          && trainingDoc(d.trainingId).status != 'cancelled'
          && request.time < trainingDoc(d.trainingId).startAt
          && d.childId in groupDoc(d.groupId).get('memberChildIds', []);
      }

      allow read: if isAdmin()
        || isParentOfChild(resource.data.childId)
        || isGroupCoach(resource.data.groupId)
        || isGroupCoach(trainingDoc(resource.data.trainingId).groupId);

      allow create, update: if validRsvp(request.resource.data) && canRsvp(request.resource.data);

      allow delete: if isParentOfChild(resource.data.childId)
        && request.time < trainingDoc(resource.data.trainingId).startAt;
    }

    // -------------------------------------------------------------- attendance
    // Coach-recorded; id = {trainingId}_{childId}; "not marked" = no doc.
    match /attendance/{attendanceId} {
      function validAttendance(d) {
        return d.keys().hasOnly(['trainingId', 'groupId', 'childId', 'status', 'markedBy', 'markedAt', 'note'])
          && d.trainingId is string && d.childId is string && d.groupId is string
          && attendanceId == d.trainingId + '_' + d.childId
          && d.status in ['present', 'absent', 'excused']
          && d.markedBy == uid()
          && d.markedAt is timestamp
          && optString(d, 'note', 500);
      }

      function canMark(d) {
        return exists(/databases/$(database)/documents/trainings/$(d.trainingId))
          && trainingDoc(d.trainingId).groupId == d.groupId
          && isGroupCoach(d.groupId)
          && d.childId in groupDoc(d.groupId).get('memberChildIds', []);
      }

      allow read: if isAdmin()
        || isParentOfChild(resource.data.childId)
        || isGroupCoach(resource.data.groupId)
        || isGroupCoach(trainingDoc(resource.data.trainingId).groupId);

      allow create, update: if validAttendance(request.resource.data) && canMark(request.resource.data);
      allow delete: if isGroupCoach(resource.data.groupId);
    }

    // ---------------------------------------------------------------- feedback
    match /feedback/{feedbackId} {
      function validRating(r, k) {
        return !(k in r) || (r[k] is int && r[k] >= 1 && r[k] <= 5);
      }

      function validRatings(r) {
        return r is map
          && r.keys().hasOnly(['technique', 'discipline', 'teamwork', 'effort', 'improvement'])
          && validRating(r, 'technique') && validRating(r, 'discipline')
          && validRating(r, 'teamwork') && validRating(r, 'effort')
          && validRating(r, 'improvement');
      }

      function validFeedback(d) {
        return d.keys().hasOnly([
                 'childId', 'groupId', 'coachId', 'coachName', 'trainingId', 'createdAt',
                 'ratings', 'comment', 'visibleToParent'])
          && d.childId is string && d.groupId is string
          && validRatings(d.ratings)
          && optString(d, 'comment', 500)
          && optString(d, 'coachName', 200)
          && optString(d, 'trainingId', 200)
          && d.createdAt is timestamp
          && d.visibleToParent == true;
      }

      allow read: if isAdmin()
        || isParentOfChild(resource.data.childId)
        || isCoachOfChild(resource.data.childId);

      allow create: if isGroupCoach(request.resource.data.groupId)
        && validFeedback(request.resource.data)
        && request.resource.data.coachId == uid()
        && request.resource.data.childId in groupDoc(request.resource.data.groupId).get('memberChildIds', []);

      // Only the author (still coach of the group) edits ratings/comment. Parents never write.
      allow update: if resource.data.coachId == uid()
        && isGroupCoach(resource.data.groupId)
        && validFeedback(request.resource.data)
        && changedOnly(['ratings', 'comment']);

      allow delete: if signedIn() && resource.data.coachId == uid();
    }

    // --------------------------------------------------------- training plans
    // Coaches of EVERY listed group (1–10) create/update. readerIds (parents +
    // coaches while published) and coachIds (coaches of the groups) are
    // server-managed (onTrainingPlanWritten / onGroupWritten), as is
    // validationErrors. Links are https only (enforced server-side, see
    // below). Parents read published plans whose readerIds contain them
    // (query: readerIds array-contains uid, status == published); coaches
    // query coachIds array-contains uid.
    match /trainingPlans/{planId} {
      // Approved coach (checked once) listed in coachIds of every group.
      // Kept lean: rules stop after 1000 evaluated expressions. At most 9
      // groups per client write: a request may read only 10 documents
      // (caller's users doc + 9 groups) — the contract's 10th group cannot be
      // verified by rules (measured in the emulator, also inside a batch).
      function inCoaches(g) {
        return uid() in get(/databases/$(database)/documents/groups/$(g)).data.get('coachIds', []);
      }

      // Like isApprovedCoach() but without exists(): exists + get of the same
      // doc count as two of the 10 allowed reads (a missing doc errors → deny).
      function approvedCoachNoExists() {
        let u = get(userPath(uid())).data;
        return signedIn() && u.role == 'coach' && u.get('coachStatus', '') == 'approved';
      }

      function coachOfAll(gs) {
        return gs is list && gs.size() >= 1 && gs.size() <= 9
          && approvedCoachNoExists()
          && inCoaches(gs[0])
          && (gs.size() < 2 || inCoaches(gs[1]))
          && (gs.size() < 3 || inCoaches(gs[2]))
          && (gs.size() < 4 || inCoaches(gs[3]))
          && (gs.size() < 5 || inCoaches(gs[4]))
          && (gs.size() < 6 || inCoaches(gs[5]))
          && (gs.size() < 7 || inCoaches(gs[6]))
          && (gs.size() < 8 || inCoaches(gs[7]))
          && (gs.size() < 9 || inCoaches(gs[8]));
      }

      // Exercises are validated by the SERVER, not here: Firestore rules stop
      // after 1000 evaluated expressions per request, and per-exercise /
      // per-link checks exhaust that budget at roughly 10–20 exercises (measured
      // in the emulator), far below the contract's 50 exercises × 10 media.
      // The rules enforce the list size (≤ 50); onTrainingPlanWritten runs
      // lib/trainingPlans.validatePlan (names, numbers, ≤ 10 media, kinds,
      // storage paths, https-only links) and QUARANTINES an invalid plan:
      // status forced back to 'draft', readerIds [], validationErrors set, no
      // publish notification — so a bad link never reaches a parent.

      function validPlan(d) {
        return d.keys().hasOnly([
                 'title', 'description', 'type', 'groupIds', 'clubId', 'startDate', 'endDate',
                 'status', 'exercises', 'createdBy', 'coachName', 'createdAt', 'updatedAt',
                 'publishedAt', 'readerIds', 'coachIds', 'validationErrors', 'updatedBy'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && optString(d, 'description', 4000)
          && optString(d, 'coachName', 200)
          && d.type in ['seasonal', 'monthly', 'weekly', 'exercise', 'homework']
          && d.groupIds is list && d.groupIds.size() >= 1 && d.groupIds.size() <= 10
          && d.groupIds.toSet().size() == d.groupIds.size()
          && d.clubId is string
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (d.get('endDate', null) == null
              || (d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                  && d.endDate >= d.startDate))
          && d.status in ['draft', 'published', 'archived']
          && d.createdAt is timestamp
          && d.updatedAt is timestamp
          && optTimestamp(d, 'publishedAt')
          && (!('exercises' in d) || (d.exercises is list && d.exercises.size() <= 50));
      }

      function okTransition(from, to) {
        return from == to
          || (from == 'draft' && to == 'published')
          || (from == 'published' && to in ['draft', 'archived']);
      }

      allow read: if isAdmin()
        || isClubAdmin(resource.data.get('clubId', ''))
        || (isParent() && resource.data.status == 'published'
            && uid() in resource.data.get('readerIds', []))
        || (isApprovedCoach() && uid() in resource.data.get('coachIds', []))
        || (isApprovedCoach() && resource.data.get('createdBy', '') == uid())
        || (isApprovedCoach()
            && (isGroupCoach(resource.data.groupIds[0])
                || (resource.data.groupIds.size() > 1 && isGroupCoach(resource.data.groupIds[1]))));

      allow create: if validPlan(request.resource.data)
        && coachOfAll(request.resource.data.groupIds)
        && request.resource.data.clubId == groupDoc(request.resource.data.groupIds[0]).clubId
        && request.resource.data.createdBy == uid()
        && request.resource.data.get('updatedBy', uid()) == uid()
        && request.resource.data.status in ['draft', 'published']
        && !('readerIds' in request.resource.data)
        && !('coachIds' in request.resource.data)
        && !('validationErrors' in request.resource.data);

      // Coach of every old AND new group; status transitions draft→published,
      // published→draft, published→archived (archived is final).
      allow update: if validPlan(request.resource.data)
        && coachOfAll(request.resource.data.groupIds)
        && (request.resource.data.groupIds == resource.data.groupIds || coachOfAll(resource.data.groupIds))
        && !changed(['createdBy', 'createdAt', 'clubId', 'readerIds', 'coachIds', 'validationErrors'])
        // The audit actor (plan.publish / plan.archive) is whoever wrote last.
        && request.resource.data.get('updatedBy', '') == uid()
        && okTransition(resource.data.status, request.resource.data.status);

      // Only drafts are deleted (published plans are archived).
      allow delete: if isApprovedCoach()
        && resource.data.status == 'draft'
        && (resource.data.createdBy == uid() || coachOfAll(resource.data.groupIds));
    }

    // Self-reported progress; id = {planId}_{exerciseId}_{childId}. Written by
    // a parent of the child who is a reader of the PUBLISHED plan; the child
    // must be a member of one of the plan's groups.
    match /exerciseProgress/{progressId} {
      function validProgress(d) {
        return d.keys().hasOnly(['planId', 'exerciseId', 'childId', 'groupId', 'parentId', 'status', 'viewedAt', 'updatedAt'])
          && d.planId is string && d.exerciseId is string && d.childId is string && d.groupId is string
          && progressId == d.planId + '_' + d.exerciseId + '_' + d.childId
          && d.parentId == uid()
          && d.status in ['not_started', 'in_progress', 'completed']
          && optTimestamp(d, 'viewedAt')
          && d.updatedAt is timestamp;
      }

      function canWrite(d) {
        return isParentOfChild(d.childId)
          && planDoc(d.planId).status == 'published'
          && uid() in planDoc(d.planId).get('readerIds', [])
          && d.groupId in planDoc(d.planId).groupIds
          && d.childId in groupDoc(d.groupId).get('memberChildIds', []);
      }

      allow read: if isAdmin()
        || (signedIn() && resource.data.parentId == uid())
        || isParentOfChild(resource.data.childId)
        || (isApprovedCoach() && uid() in planDoc(resource.data.planId).get('coachIds', []))
        || isGroupCoach(resource.data.groupId);

      allow create: if validProgress(request.resource.data) && canWrite(request.resource.data);
      allow update: if validProgress(request.resource.data) && canWrite(request.resource.data)
        && !changed(['planId', 'exerciseId', 'childId', 'groupId']);
      allow delete: if signedIn() && resource.data.parentId == uid();
    }

    // id = {planId}_{parentId}; written by the parent (a reader of the
    // published plan), read by the plan's coaches (query planId == X).
    match /planViews/{viewId} {
      function validView(d) {
        return d.keys().hasOnly(['planId', 'parentId', 'firstViewedAt', 'lastViewedAt'])
          && d.planId is string
          && d.parentId == uid()
          && viewId == d.planId + '_' + uid()
          && d.firstViewedAt is timestamp
          && d.lastViewedAt is timestamp;
      }

      function canView(d) {
        return isParent()
          && planDoc(d.planId).status == 'published'
          && uid() in planDoc(d.planId).get('readerIds', []);
      }

      allow read: if isAdmin()
        || (signedIn() && resource.data.parentId == uid())
        || (isApprovedCoach() && uid() in planDoc(resource.data.planId).get('coachIds', []));
      allow create: if validView(request.resource.data) && canView(request.resource.data);
      allow update: if validView(request.resource.data) && canView(request.resource.data)
        && !changed(['planId', 'parentId', 'firstViewedAt']);
      allow delete: if false;
    }

    // ----------------------------------------------------------- notifications
    // Server-written inbox (notify()); the owner may only flip read false -> true.
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow update: if signedIn()
        && resource.data.userId == uid()
        && changedOnly(['read'])
        && resource.data.read == false
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // ------------------------------------------------------------- media posts
    // Created by an approved coach of EVERY listed group (≤ 5 groups) with
    // consentConfirmed == true. readerIds / hidden / reportCount are
    // server-managed; readerIds = coaches + parents of the listed groups,
    // recomputed on every membership change (onGroupWritten).
    match /mediaPosts/{postId} {
      function coachOfAll(gs) {
        return gs is list && gs.size() >= 1 && gs.size() <= 5
          && isGroupCoach(gs[0])
          && (gs.size() < 2 || isGroupCoach(gs[1]))
          && (gs.size() < 3 || isGroupCoach(gs[2]))
          && (gs.size() < 4 || isGroupCoach(gs[3]))
          && (gs.size() < 5 || isGroupCoach(gs[4]));
      }

      function mediaPath(p) {
        return p is string && p.matches('^media/' + uid() + '/' + postId + '/[^/]+$');
      }

      allow read: if isAdmin()
        || (signedIn() && resource.data.coachId == uid())
        || ((isParent() || isApprovedCoach()) && uid() in resource.data.get('readerIds', []))
        || isClubAdmin(resource.data.get('clubId', ''));

      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly([
             'coachId', 'coachName', 'groupIds', 'clubId', 'type', 'storagePath', 'thumbPath',
             'caption', 'durationSec', 'createdAt', 'consentConfirmed'])
        && request.resource.data.coachId == uid()
        && request.resource.data.consentConfirmed == true
        && coachOfAll(request.resource.data.groupIds)
        && request.resource.data.clubId == groupDoc(request.resource.data.groupIds[0]).clubId
        && request.resource.data.type in ['photo', 'video']
        && mediaPath(request.resource.data.storagePath)
        && (request.resource.data.get('thumbPath', null) == null || mediaPath(request.resource.data.thumbPath))
        && optString(request.resource.data, 'caption', 2000)
        && optString(request.resource.data, 'coachName', 200)
        && (request.resource.data.get('durationSec', null) == null || request.resource.data.durationSec is number)
        && request.resource.data.createdAt is timestamp;

      allow update: if false;
      allow delete: if signedIn() && resource.data.coachId == uid();
    }

    // ------------------------------------------------------------- moderation
    // Any group member may report content of their group (the createReport
    // callable adds rate limiting and target checks). Decisions: moderate callable.
    match /reports/{reportId} {
      allow read: if isAdmin()
        || isClubAdmin(resource.data.get('clubId', ''))
        || (signedIn() && resource.data.reporterId == uid());

      allow create: if (isGroupParent(request.resource.data.groupId) || isGroupCoach(request.resource.data.groupId))
        && request.resource.data.keys().hasOnly([
             'targetType', 'targetPath', 'groupId', 'clubId', 'reason', 'note', 'preview',
             'reporterId', 'createdAt', 'status'])
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.clubId == groupDoc(request.resource.data.groupId).clubId
        && request.resource.data.targetType in ['chatMessage', 'mediaPost', 'trainingPhoto']
        && request.resource.data.targetPath is string && request.resource.data.targetPath.size() <= 500
        && request.resource.data.reason in ['inappropriate', 'privacy', 'spam', 'other']
        && optString(request.resource.data, 'note', 500)
        && optString(request.resource.data, 'preview', 200)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Append-only; platform admins read all, club admins their clubs.
    match /auditLog/{entryId} {
      allow read: if isAdmin() || isClubAdmin(resource.data.get('clubId', ''));
      allow write: if false;
    }

    // ------------------------------------------------------- account requests
    match /accountRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == uid());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'status', 'createdAt'])
        && request.resource.data.uid == uid()
        && request.resource.data.type in ['delete', 'export']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------- server-only logs
    match /smsLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /groupAuditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
