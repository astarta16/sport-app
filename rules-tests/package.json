{
  "name": "sport-parent-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security-rules tests for Firestore and Storage, run against the local emulators.",
  "scripts": {
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore,storage --project demo-sport-parent --config ../firebase.json \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "^12.0.0",
    "firebase-tools": "13.35.1",
    "vitest": "^3.2.7"
  }
}
